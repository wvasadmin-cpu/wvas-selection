# Copy to .env.local for local development. Never commit real values.

# Auth.js (Google sign-in for the admin pages)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails allowed into the admin pages
ADMIN_EMAILS=

# Airtable (read-only personal access token, scoped to the applications base)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# Table name or id, e.g. "New Exhibitor Application"
AIRTABLE_TABLE=
# Separate token with data.records:write on the same base, for the /apply form
AIRTABLE_WRITE_TOKEN=
# Master membership table id (tbl...), for the /join associate membership form
AIRTABLE_MEMBERS_TABLE=
